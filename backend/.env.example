# Copy this file to .env and fill in your values. Never commit .env.

# "ollama" (local, free, needs `ollama serve` running) or "groq" (cloud, fast, needs key)
LLM_PROVIDER=ollama

# Only needed when LLM_PROVIDER=groq. Get a free key at https://console.groq.com
# GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults: llama3.2 (ollama) / openai/gpt-oss-20b (groq)
# LLM_MODEL=llama3.2

# Where Ollama is listening. From inside Docker the host machine is
# host.docker.internal (docker-compose.yml sets this for you). Running the
# backend directly with uvicorn? Leave it unset, localhost:11434 is the default.
# OLLAMA_HOST=http://host.docker.internal:11434

# Optional. Comma-separated list of allowed extension origins; * = any.
ALLOWED_ORIGINS=*

# Optional. Per-IP limit on /ask.
MAX_ASKS_PER_MINUTE=10

# Retrieval tuning (defaults shown).
# TOP_K=5                 # chunks handed to the LLM
# RERANK_ENABLED=1        # 0 = skip the cross-encoder
# RERANK_MIN_SCORE=-6     # drop chunks the reranker scores below this

# Generation.
# MAX_ANSWER_TOKENS=800   # ollama defaults to 128, which truncates answers

# Memory and storage.
# MAX_STORED_PAGES=200    # oldest-first eviction above this
# ASKPAGE_DATA_DIR=data   # where traces.jsonl is written
